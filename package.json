{
  "name": "course-atlas",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "高校模拟排课与学分路径规划器 ——《前端开发实训》期末工程项目（Web 方向）",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,vue,css}\""
  },
  "dependencies": {
    "pinia": "^3.0.0",
    "vue": "^3.5.46",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-vue": "^10.0.0",
    "globals": "^17.14.0",
    "playwright-core": "^1.65.1",
    "prettier": "^3.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.3.8",
    "vue-tsc": "^3.3.14"
  }
}
